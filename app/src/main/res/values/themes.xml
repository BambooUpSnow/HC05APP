<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         全局深色主题（基于 Material Components）
         背景 #0F172A / 卡片 #111827 / 强调色 #38BDF8
         ============================================================ -->
    <style name="Theme.SignLanguage" parent="Theme.MaterialComponents.NoActionBar">

        <!-- 主色 -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>

        <!-- 次色 -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>

        <!-- 背景 / 表面 -->
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/heart</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- 窗口 -->
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:navigationBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- 大号指标文本 -->
    <style name="MetricValue">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 卡片小标题 -->
    <style name="CardLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- 底部 / 顶部的胶囊按钮 -->
    <style name="PillButton">
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
